{
  "1": {
    "class_type": "LoadImage",
    "inputs": {
      "image": "REFERENCE_IMAGE.png",
      "upload": "image"
    },
    "_meta": { "title": "reference_image" }
  },
  "2": {
    "class_type": "UNETLoader",
    "inputs": {
      "unet_name": "qwen_image_2.1_int8_convrot.safetensors",
      "weight_dtype": "default"
    },
    "_meta": { "title": "diffusion_model" }
  },
  "3": {
    "class_type": "CLIPLoader",
    "inputs": {
      "clip_name": "qwen3vl_8b_int8_convrot.safetensors",
      "type": "qwen_image",
      "device": "default"
    },
    "_meta": { "title": "text_encoder" }
  },
  "4": {
    "class_type": "VAELoader",
    "inputs": {
      "vae_name": "qwen_image_2.1_vae_bf16.safetensors"
    },
    "_meta": { "title": "vae" }
  },
  "5": {
    "class_type": "TextEncodeQwenImage21",
    "inputs": {
      "clip": ["3", 0],
      "prompt": "Remove the background, and output a PNG image",
      "negative_prompt": "",
      "vae": ["4", 0],
      "resolution": 1024,
      "images.image_1": ["1", 0]
    },
    "_meta": { "title": "prompt" }
  },
  "6": {
    "class_type": "KSampler",
    "inputs": {
      "model": ["2", 0],
      "positive": ["5", 0],
      "negative": ["5", 1],
      "latent_image": ["5", 2],
      "seed": 42,
      "steps": 25,
      "cfg": 1.0,
      "sampler_name": "euler",
      "scheduler": "simple",
      "denoise": 1.0
    },
    "_meta": { "title": "sampler" }
  },
  "7": {
    "class_type": "VAEDecode",
    "inputs": {
      "samples": ["6", 0],
      "vae": ["4", 0]
    },
    "_meta": { "title": "decode" }
  },
  "8": {
    "class_type": "SaveImage",
    "inputs": {
      "images": ["7", 0],
      "filename_prefix": "qwen21_edit"
    },
    "_meta": { "title": "save" }
  }
}
